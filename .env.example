# Kimi control-plane credentials. Never expose these to tool containers.
MOONSHOT_API_KEY=
CYBERKIMI_DATABASE_URL=sqlite:///./cyberkimi.db
CYBERKIMI_HOME=.cyberkimi
CYBERKIMI_MODEL=kimi-k3
CYBERKIMI_MODEL_BASE_URL=https://api.moonshot.ai/v1
CYBERKIMI_SIGNING_KEY=
CYBERKIMI_VAULT_KEY=
# Comprehensive operators remain disabled unless explicitly enabled by the host administrator.
CYBERKIMI_ENABLE_COMPREHENSIVE=0
